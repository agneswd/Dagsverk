{
  "name": "dagsverk",
  "version": "0.1.0",
  "description": "Offline-first time, salary, and workspace tracking for desktop.",
  "author": "agneswd",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:start": "cross-env NODE_ENV=development electron dist-electron/main.js",
    "dev": "concurrently -k \"ng serve\" \"wait-on tcp:4200 && npm run build:electron && npm run electron:start\"",
    "build:all": "ng build && npm run build:electron",
    "dist": "npm run build:all && electron-builder",
    "visual:capture": "npx tsx scripts/capture-screens.ts"
  },
  "private": true,
  "build": {
    "appId": "dev.agneswd.dagsverk",
    "productName": "Dagsverk",
    "files": [
      "dist/dagsverk/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "agneswd",
      "repo": "Dagsverk"
    }
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.2",
    "@fontsource/material-icons": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.2",
    "@fontsource/roboto": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "decimal.js": "^10.6.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.7.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}
